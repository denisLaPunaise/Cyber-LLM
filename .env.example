# ── Configuration de Cyber-LLM ─────────────────────────────
# 1. Copie ce fichier :   cp .env.example .env   (Windows : copy .env.example .env)
# 2. Mets ta vraie clé dans .env  (jamais ici dans .env.example)
# 3. Le .env est ignoré par git → il ne partira jamais sur GitHub

# Ta clé API Anthropic (commence par sk-ant-...). Le SDK la lit automatiquement.
ANTHROPIC_API_KEY=sk-ant-remplace-moi

# Modèle Claude utilisé par l'assistant (configurable)
CYBER_LLM_MODEL=claude-opus-5-5

# (Optionnel) ID du workspace — À REMPLIR SEULEMENT si ta clé n'est pas
# rattachée à un workspace (erreur 400 « not scoped to a workspace »).
# Sinon, laisse cette ligne commentée.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
